# PostHog project settings. Copy to .env and fill in.
# Find the key at Settings -> Project settings -> Project API Key.
# It looks like phc_xxxxxxxxxxxxxxxxxxxx
# The numeric project ID (e.g. 673583) is NOT the key.
POSTHOG_KEY=

# https://us.i.posthog.com (default) or https://eu.i.posthog.com
POSTHOG_HOST=https://us.i.posthog.com

# The token the site checks before it stores a shared vibescape. The site
# keeps the payload of a share and gives back a short URL for it
# (vibresia.com/s/<id>), and this is what stops that endpoint being used as
# free storage by anyone who finds it. It ships inside the app, so it is a
# speed bump rather than a lock.
#
# The same value as the Worker's SHARE_TOKEN secret:
#   npx wrangler secret put SHARE_TOKEN
SHARE_TOKEN=

# Read-only credentials, used only by scripts/check-posthog-live.py and never
# shipped in the app. They exist because PostHog answers 200 {"status":"Ok"} for
# a rotated or deleted project key just as happily as for a live one, so nothing
# else can tell you whether events are actually being recorded.
#
# Create at Settings -> Personal API keys -> Create (needs read scope), and the
# numeric id is under Project settings.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# Build-time credentials for PostHog CLI debug-symbol uploads.
# Create the key with the "Source map upload" personal API key preset.
# POSTHOG_CLI_HOST is the PostHog app/API host, not the ingestion host above.
POSTHOG_CLI_API_KEY=
POSTHOG_CLI_PROJECT_ID=
POSTHOG_CLI_HOST=
