# PostHog project settings. Copy to .env and fill in.
# Find the key at Settings -> Project settings -> Project API Key.
# It looks like phc_xxxxxxxxxxxxxxxxxxxx
# The numeric project ID (e.g. 673583) is NOT the key.
POSTHOG_KEY=

# https://us.i.posthog.com (default) or https://eu.i.posthog.com
POSTHOG_HOST=https://us.i.posthog.com
